# 复制为 .env 后填写。绝不把 .env 提交到 git。
# markdown 语料目录：可以指向 Obsidian 库，也可以指向 scripts/prepare_corpus.py 生成的 data/corpus
NOTE_RAG_VAULT_PATH=./vault

# Postgres（docker compose 起的那个）
NOTE_RAG_DATABASE_URL=postgresql://note_rag:note_rag@localhost:5432/note_rag
NOTE_RAG_REDIS_URL=redis://localhost:6379/0

# 嵌入模型：留空则使用内置的离线 hashing 嵌入（无需 API key，用于跑通链路和测试）
# 填入 OpenAI 兼容的 base_url 即可切换到真实嵌入模型
NOTE_RAG_EMBED_BASE_URL=
NOTE_RAG_EMBED_API_KEY=
NOTE_RAG_EMBED_MODEL=
# 必须与所用嵌入模型的输出维度一致（离线 hashing 默认 384）
NOTE_RAG_EMBED_DIM=384

# 检索默认参数
NOTE_RAG_TOP_K=10
NOTE_RAG_RRF_K=60
